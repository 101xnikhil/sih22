# ==============================================================================
# LANDGUARD AI — Environment Configuration
# ==============================================================================

# ─────────────────────────────────────────────────────────────
# 1. DATABASE CONFIGURATION (Neon Serverless PostgreSQL or SQLite)
# ─────────────────────────────────────────────────────────────
# To use Neon DB (Cloud PostgreSQL):
# 1. Create a free project at https://neon.tech
# 2. Copy your Connection String and paste it below:
# DATABASE_URL=postgresql://user:password@ep-cool-lake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# To use local SQLite (default offline development):
DATABASE_URL=sqlite:///./landguard.db

# ─────────────────────────────────────────────────────────────
# 2. APPLICATION & SECURITY SETTINGS
# ─────────────────────────────────────────────────────────────
PROJECT_NAME="LANDGUARD AI Backend"
BACKEND_URL="http://127.0.0.1:8000"
JWT_SECRET_KEY="landguard-super-secret-jwt-key-sih-2026-auth"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Edge Gateway API Key for Physical Nodes
GATEWAY_API_KEY="landguard-edge-gw-sih2026-key"
REQUIRE_API_KEY=false

# ─────────────────────────────────────────────────────────────
# 3. BLYNK IOT CLOUD INTEGRATION
# ─────────────────────────────────────────────────────────────
BLYNK_TEMPLATE_ID="TMPL_LANDGUARD"
BLYNK_TEMPLATE_NAME="Landguard AI"
BLYNK_AUTH_TOKEN="YOUR_BLYNK_AUTH_TOKEN"

# ─────────────────────────────────────────────────────────────
# 4. EMERGENCY SMS GATEWAY (Twilio, Fast2SMS, or Custom Webhook)
# ─────────────────────────────────────────────────────────────
SMS_ENABLED=true
SMS_PROVIDER="auto"  # auto | twilio | fast2sms | webhook | simulated

# Twilio SMS API Settings (https://www.twilio.com)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Fast2SMS Quick Route (q) Live Alert Settings (https://www.fast2sms.com)
FAST2SMS_API_KEY=""
ALERT_SMS_RECIPIENTS="9876543210,9876543211"
SMS_ALERTS_ENABLED=false
SMS_MIN_SEVERITY="HIGH"
SMS_MAX_PER_DAY=20

# Custom SMS Webhook Gateway
CUSTOM_SMS_GATEWAY_URL=""
CUSTOM_SMS_API_KEY=""

# Designated Emergency Contacts (comma-separated)
EMERGENCY_PHONE_NUMBERS="+919506758710"

# ─────────────────────────────────────────────────────────────
# 5. GOOGLE CLOUD XGBOOST ML PIPELINE
# ─────────────────────────────────────────────────────────────
GCP_WEBHOOK_URL="https://us-central1-landguard-ai.cloudfunctions.net/landguard-ml-pipeline"

